{
  "name": "summarizer-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "网页、YouTube 与 PDF 的总结和内容问答扩展",
  "exports": { "./core": "./src/core/index.ts" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "@types/node": "^22.13.4",
    "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vite": "^6.2.1"
  }
}
